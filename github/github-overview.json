{
  "meta": {
    "key": "github-overview",
    "version": 1,
    "integration_id": "github",
    "tags": [
      "github",
      "cicd"
    ]
  },
  "name": "GitHub Overview",
  "description": "CI runs, deployments, pull requests and activity from the GitHub integration's events.",
