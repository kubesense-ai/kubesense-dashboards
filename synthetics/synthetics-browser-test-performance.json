    "variables": [
      {
        "name": "env",
        "description": "Monitor label env.",
        "meta": {
          "variableType": "metrics",
          "metric": "kubesense_synthetics_monitor_status",
          "fieldMeta": {
            "field": "label_env",
            "type": "string",
            "is_attribute": false
          },
          "selectType": "multiple",
          "value": []
        }
      },
      {
        "name": "team",
        "description": "Monitor label team.",
        "meta": {
          "variableType": "metrics",
          "metric": "kubesense_synthetics_monitor_status",
          "fieldMeta": {
            "field": "label_team",
            "type": "string",
            "is_attribute": false
          },
          "selectType": "multiple",
          "value": []
        }
      },
      {
        "name": "service",
        "description": "Monitor label service.",
        "meta": {
          "variableType": "metrics",
          "metric": "kubesense_synthetics_monitor_status",
