    ],
    "panels": [
      {
        "name": "Browser runs",
        "description": "Browser check runs in the selected time range.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [],
            "aggregation": {
              "function": "row_count"
            },
            "chart_type": "stat",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ],
              "@_@run_type": [
                ":$run_type"
              ]
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "sum"
          }
        }
      },
      {
        "name": "Success rate",
        "description": "Successful runs over all browser runs in the selected time range.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "(sum (increase(kubesense_synthetics_runs_total{status=\"success\", label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__time_filter])) or sum (increase(kubesense_synthetics_runs_total{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__time_filter])) * 0) / sum (increase(kubesense_synthetics_runs_total{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__time_filter])) * 100",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "percentage",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "Failed runs",
        "description": "Failed browser runs in the selected time range.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [],
            "aggregation": {
              "function": "row_count"
            },
            "chart_type": "stat",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ],
              "status": [
                "failure"
              ],
              "@_@run_type": [
                ":$run_type"
              ]
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "sum"
          }
        }
      },
      {
        "name": "Average run duration",
        "description": "Mean duration of the browser runs over the whole time range (run-duration histogram sum ÷ count).",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum (increase(kubesense_synthetics_run_duration_seconds_sum{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__time_filter])) / sum (increase(kubesense_synthetics_run_duration_seconds_count{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__time_filter])) * 1000",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "milliseconds",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "p95 run duration",
        "description": "95th percentile of browser run duration over the whole time range, estimated from the run-duration histogram (buckets up to 30 s: anything slower shows as 30 s).",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "histogram_quantile(0.95, sum by (le) (increase(kubesense_synthetics_run_duration_seconds_bucket{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__time_filter]))) * 1000",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "milliseconds",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "Browser monitor status",
        "description": "Current state and uptime of the browser monitors over the dashboard's time range. This widget lists all browser monitors; the label, monitor and location pickers narrow the other panels.",
        "panelType": "syntheticsMonitor",
        "queries": [
          {
            "selectedMode": "synthetics_monitor",
            "label": "A",
            "visible": true,
            "widgetType": "status_list",
            "filter": {
              "types": [
                "BROWSER"
              ]
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "milliseconds"
        }
      },
      {
        "name": "Runs by result",
        "description": "Browser runs per interval, by outcome.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (status) (increase(kubesense_synthetics_runs_total{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__rate_interval]))",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number"
        }
      },
      {
        "name": "Success rate by location",
        "description": "Share of successful browser runs per location.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "(sum by (location) (increase(kubesense_synthetics_runs_total{status=\"success\", label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__rate_interval])) or sum by (location) (increase(kubesense_synthetics_runs_total{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__rate_interval])) * 0) / sum by (location) (increase(kubesense_synthetics_runs_total{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__rate_interval])) * 100",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "percentage"
        }
      },
      {
        "name": "Run duration p95",
        "description": "95th percentile total run time per interval.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [],
            "aggregation": {
              "function": "p95",
              "fields": [
                {
                  "field": "total_ms",
                  "type": "float",
                  "is_attribute": false
                }
              ]
            },
            "chart_type": "timeseries",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ],
              "@_@run_type": [
                ":$run_type"
