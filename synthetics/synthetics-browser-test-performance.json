    "panels": [
      {
        "name": "Browser runs",
        "description": "Browser check runs in the selected time range.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [],
            "aggregation": {
              "function": "row_count"
            },
            "chart_type": "stat",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ]
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "sum"
          }
        }
      },
      {
        "name": "Success rate",
        "description": "Successful runs over all browser runs in the selected time range.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum (increase(kubesense_synthetics_runs_total{status=\"success\", label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__time_filter])) / sum (increase(kubesense_synthetics_runs_total{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__time_filter])) * 100",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "percentage",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "Failed runs",
        "description": "Failed browser runs in the selected time range.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [],
            "aggregation": {
              "function": "row_count"
            },
            "chart_type": "stat",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ],
              "status": [
                "failure"
              ]
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "sum"
          }
        }
      },
      {
        "name": "Average run duration",
        "description": "Mean total run time of a browser run.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [],
            "aggregation": {
              "function": "avg",
              "fields": [
                {
                  "field": "total_ms",
                  "type": "float",
                  "is_attribute": false
                }
              ]
            },
            "chart_type": "stat",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ]
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "milliseconds",
          "valueOptions": {
            "show": "calculate",
            "calculation": "mean"
          }
        }
      },
      {
        "name": "p95 run duration",
        "description": "95th percentile total run time of a browser run.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [],
            "aggregation": {
              "function": "p95",
              "fields": [
                {
                  "field": "total_ms",
