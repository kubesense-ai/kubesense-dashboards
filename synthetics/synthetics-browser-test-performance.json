        "config": {
          "yAxisLabelFormatter": "number"
        }
      },
      {
        "name": "Slowest browser monitors (p95)",
        "description": "95th percentile total run time per browser monitor.",
        "panelType": "topList",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [
              {
                "field": "monitor_name",
                "type": "string",
                "is_attribute": false
