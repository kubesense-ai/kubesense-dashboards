            },
            "chart_type": "topList",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ]
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "milliseconds"
        }
      },
      {
        "name": "Slowest steps",
        "description": "Mean duration of each top-level step over the selected time range, slowest first (step names are cut at 64 characters).",
        "panelType": "topList",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "topk(10, sum by (monitor_name, step) (rate(kubesense_synthetics_step_duration_seconds_sum{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__time_filter])) / sum by (monitor_name, step) (rate(kubesense_synthetics_step_duration_seconds_count{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__time_filter])))",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "seconds"
        }
      },
      {
        "name": "Step duration over time",
        "description": "Mean duration per step (skipped steps are not observed).",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (step) (rate(kubesense_synthetics_step_duration_seconds_sum{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__rate_interval])) / sum by (step) (rate(kubesense_synthetics_step_duration_seconds_count{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__rate_interval]))",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "seconds"
        }
      },
      {
        "name": "Recent failed browser runs",
        "description": "Latest failed browser runs; open one in Explore for its trace.",
        "panelType": "list",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [
              {
                "field": "timestamp",
                "type": "string",
                "is_attribute": false
              },
              {
                "field": "monitor_name",
                "type": "string",
                "is_attribute": false
              },
              {
                "field": "location",
                "type": "string",
                "is_attribute": false
              },
              {
                "field": "failure_code",
                "type": "string",
                "is_attribute": false
              },
              {
                "field": "error_message",
                "type": "string",
                "is_attribute": false
              }
            ],
            "groupBy": [],
            "aggregation": {
              "function": "row_count"
            },
            "chart_type": "list",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
