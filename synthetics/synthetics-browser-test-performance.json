            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "milliseconds"
        }
      },
      {
        "name": "Run duration p95 by location",
        "description": "95th percentile total run time per location.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [
              {
                "field": "location",
                "type": "string",
                "is_attribute": false
              }
            ],
            "aggregation": {
              "function": "p95",
              "fields": [
                {
                  "field": "total_ms",
                  "type": "float",
                  "is_attribute": false
                }
              ]
            },
            "chart_type": "timeseries",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ],
              "@_@run_type": [
                ":$run_type"
              ]
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "milliseconds"
        }
      },
      {
        "name": "Failures by error type",
        "description": "Failed browser runs by failure code (TIMEOUT, ASSERTION_FAILED, ...).",
        "panelType": "topList",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [
              {
                "field": "failure_code",
                "type": "string",
                "is_attribute": false
              }
            ],
            "aggregation": {
              "function": "row_count"
            },
            "chart_type": "topList",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ],
              "status": [
                "failure"
              ],
              "@_@run_type": [
                ":$run_type"
              ]
            },
            "sorting": {
              "sortBy": {
                "field": "",
                "type": "string",
                "is_attribute": false
              },
              "sortOrder": "DESC"
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "milliseconds"
        }
      },
      {
        "name": "Failures over time by error type",
        "description": "Failed browser runs per interval, by failure code.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (failure_code) (increase(kubesense_synthetics_runs_total{status=\"failure\", label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__rate_interval]))",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number"
        }
      },
      {
        "name": "Slowest browser monitors (p95)",
        "description": "95th percentile total run time per browser monitor.",
        "panelType": "topList",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [
              {
                "field": "monitor_name",
                "type": "string",
                "is_attribute": false
              }
            ],
            "aggregation": {
              "function": "p95",
              "fields": [
                {
                  "field": "total_ms",
                  "type": "float",
                  "is_attribute": false
                }
              ]
            },
            "chart_type": "topList",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ],
              "@_@run_type": [
                ":$run_type"
              ]
            },
            "sorting": {
              "sortBy": {
                "field": "",
                "type": "string",
                "is_attribute": false
              },
              "sortOrder": "DESC"
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "milliseconds"
        }
      },
      {
        "name": "Slowest steps",
        "description": "Mean duration of each top-level step over the selected time range, slowest first (step names are cut at 64 characters).",
        "panelType": "topList",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "topk(10, sum by (monitor_name, step) (rate(kubesense_synthetics_step_duration_seconds_sum{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\", step=~\"$step\"}[$__time_filter])) / sum by (monitor_name, step) (rate(kubesense_synthetics_step_duration_seconds_count{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\", step=~\"$step\"}[$__time_filter])))",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "seconds"
        }
      },
      {
        "name": "Step duration over time",
        "description": "Mean duration per step (skipped steps are not observed).",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (step) (rate(kubesense_synthetics_step_duration_seconds_sum{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\", step=~\"$step\"}[$__rate_interval])) / sum by (step) (rate(kubesense_synthetics_step_duration_seconds_count{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\", step=~\"$step\"}[$__rate_interval]))",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "seconds"
        }
      },
      {
        "name": "Recent failed browser runs",
        "description": "Latest failed browser runs; open one in Explore for its trace.",
        "panelType": "list",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [
              {
                "field": "timestamp",
                "type": "string",
                "is_attribute": false
              },
              {
                "field": "monitor_name",
                "type": "string",
                "is_attribute": false
              },
              {
                "field": "location",
                "type": "string",
                "is_attribute": false
              },
              {
                "field": "failure_code",
                "type": "string",
                "is_attribute": false
              },
              {
                "field": "error_message",
                "type": "string",
                "is_attribute": false
              }
            ],
            "groupBy": [],
            "aggregation": {
              "function": "row_count"
            },
            "chart_type": "list",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ],
              "status": [
                "failure"
              ],
              "@_@run_type": [
                ":$run_type"
              ]
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "milliseconds"
        }
      },
      {
        "name": "Average run duration by location",
        "description": "Mean total run time per location (local = synthetics-api itself).",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [
              {
                "field": "location",
                "type": "string",
                "is_attribute": false
              }
            ],
            "aggregation": {
              "function": "avg",
              "fields": [
                {
                  "field": "total_ms",
                  "type": "float",
                  "is_attribute": false
                }
              ]
            },
            "chart_type": "timeseries",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
                "$env"
              ],
              "labels.team": [
                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
