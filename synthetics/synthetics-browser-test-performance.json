{
  "$schema": "../.schema/dashboard.schema.json",
  "meta": {
    "key": "synthetics-browser-test-performance",
    "version": 4,
    "requires": {
      "match": "any",
      "conditions": [
        {
          "integration": "synthetics"
        }
      ]
    },
    "tags": [
      "synthetics",
      "browser",
      "performance"
    ]
  },
  "name": "Browser Test Performance",
  "description": "Run duration, success rate, failures, Core Web Vitals, third-party resources and per-step timings of synthetic browser checks, with their firing alerts. Panels built from metrics count scheduled runs only; the run type picker (scheduled by default) narrows the rest.",
  "preset": {
    "gridLayout": [
      {
        "i": "0",
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 2
      },
      {
        "i": "1",
        "x": 3,
        "y": 0,
        "w": 2,
        "h": 2
      },
      {
        "i": "2",
        "x": 5,
        "y": 0,
        "w": 2,
        "h": 2
      },
      {
        "i": "3",
        "x": 7,
        "y": 0,
