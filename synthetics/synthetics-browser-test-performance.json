      {
        "name": "Failures by error type",
        "description": "Failed browser runs by failure code (TIMEOUT, ASSERTION_FAILED, ...).",
        "panelType": "topList",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
            "columnFields": [],
            "groupBy": [
              {
                "field": "failure_code",
                "type": "string",
                "is_attribute": false
              }
            ],
            "aggregation": {
              "function": "row_count"
            },
            "chart_type": "topList",
            "filterMode": "MFD",
            "filters": {
              "labels.env": [
