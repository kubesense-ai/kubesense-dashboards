                "$team"
              ],
              "labels.service": [
                "$service"
              ],
              "monitor_name": [
                "$monitor"
              ],
              "location": [
                "$location"
              ],
              "check_type": [
                "BROWSER"
              ]
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "milliseconds",
          "valueOptions": {
            "show": "calculate",
            "calculation": "mean"
          }
        }
      },
      {
        "name": "Browser monitor status",
        "description": "Current state and uptime of the browser monitors over the dashboard's time range. This widget lists all browser monitors; the label, monitor and location pickers narrow the other panels.",
        "panelType": "syntheticsMonitor",
        "queries": [
          {
            "selectedMode": "synthetics_monitor",
            "label": "A",
            "visible": true,
            "widgetType": "status_list",
            "filter": {
              "types": [
                "BROWSER"
              ]
            }
          }
        ],
        "config": {}
      },
      {
        "name": "Runs by result",
        "description": "Browser runs per interval, by outcome.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (status) (increase(kubesense_synthetics_runs_total{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__rate_interval]))",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number"
        }
      },
      {
        "name": "Success rate by location",
        "description": "Share of successful browser runs per location.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (location) (increase(kubesense_synthetics_runs_total{status=\"success\", label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__rate_interval])) / sum by (location) (increase(kubesense_synthetics_runs_total{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", monitor_name=~\"$monitor\", location=~\"$location\", check_type=\"BROWSER\"}[$__rate_interval])) * 100",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "percentage"
        }
      },
      {
        "name": "Run duration p95",
        "description": "95th percentile total run time per interval.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "synthetics",
            "label": "A",
