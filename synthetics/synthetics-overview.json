    "panels": [
      {
        "name": "Monitors",
        "description": "Monitors reporting a state. Paused monitors and those with no result yet are not counted.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "count(max by (monitor_id) (kubesense_synthetics_monitor_status{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", check_type=~\"$check_type\"}))",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "Up",
        "description": "",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "count(max by (monitor_id) (kubesense_synthetics_monitor_status{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", check_type=~\"$check_type\"}) == 0) or vector(0)",
            "visible": true,
            "filters": {},
            "functions": [],
