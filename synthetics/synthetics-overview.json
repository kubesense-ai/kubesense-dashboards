      },
      {
        "name": "No data",
        "description": "Monitors whose locations returned no result in time.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "count(max by (monitor_id) (kubesense_synthetics_monitor_status{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", check_type=~\"$check_type\"}) == 3) or vector(0)",
            "visible": true,
