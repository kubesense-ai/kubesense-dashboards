        "description": "",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "count(max by (monitor_id) (kubesense_synthetics_monitor_status{label_env=~\"$env\", label_team=~\"$team\", label_service=~\"$service\", check_type=~\"$check_type\"}) == 2) or vector(0)",
