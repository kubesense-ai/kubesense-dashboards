    "panels": [
      {
        "name": "Agents online",
        "description": "Registered probe agents that are online. Needs the synthetics-api /metrics scraped into the platform TSDB (the Helm chart's ServiceMonitor, off unless the operator enables it); empty otherwise.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum(max by (location) (synthetics_probe_agents{status=\"online\", location=~\"$location\"}))",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {
              "color": {
                "type": "palette",
                "palette": "success"
              }
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
