        "name": "pvc",
        "description": "",
        "meta": {
          "variableType": "metrics",
          "metric": "kube_persistentvolumeclaim_info",
          "fieldMeta": {
            "field": "persistentvolumeclaim",
            "type": "string",
            "is_attribute": false
          },
          "selectType": "multiple",
          "value": [],
          "filters": {
            "clusterId": [
              "$cluster"
            ],
            "namespace": [
              "$namespace"
            ]
