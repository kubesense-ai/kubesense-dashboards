      }
    ],
    "panels": [
      {
        "name": "Claims",
        "description": "",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "count(kube_persistentvolumeclaim_info{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "Pending claims",
        "description": "",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum(kube_persistentvolumeclaim_status_phase{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\", phase=\"Pending\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {
              "color": {
                "type": "palette",
                "palette": "warning"
              }
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "Lost claims",
        "description": "",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum(kube_persistentvolumeclaim_status_phase{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\", phase=\"Lost\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {
              "color": {
                "type": "palette",
                "palette": "error"
              }
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "Fullest volume",
        "description": "",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "max(kubelet_volume_stats_used_bytes{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"} / kubelet_volume_stats_capacity_bytes{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"}) * 100",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "percentage",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "Volume usage",
        "description": "Mounted volumes only.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_used_bytes{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"} / kubelet_volume_stats_capacity_bytes{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"}) * 100",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "percentage"
        }
      },
      {
        "name": "Fullest volumes",
        "description": "",
        "panelType": "topList",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "topk(10, max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_used_bytes{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"} / kubelet_volume_stats_capacity_bytes{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"}) * 100)",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "percentage"
        }
      },
      {
        "name": "Used bytes",
        "description": "",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_used_bytes{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "bytes"
        }
      },
      {
        "name": "Inodes used",
        "description": "",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_inodes_used{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"} / kubelet_volume_stats_inodes{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"}) * 100",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "percentage"
        }
      },
      {
        "name": "Days until full",
        "description": "Projection from the last six hours of growth. Only volumes forecast to fill within 30 days.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_available_bytes{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"} / clamp_min(-deriv(kubelet_volume_stats_available_bytes{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"}[6h]), 1)) / 86400 < 30",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number"
        }
      },
      {
        "name": "Requested storage by claim",
        "description": "",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (namespace, persistentvolumeclaim) (kube_persistentvolumeclaim_resource_requests_storage_bytes{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "bytes"
        }
      },
      {
        "name": "Claims by phase",
        "description": "",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (phase) (kube_persistentvolumeclaim_status_phase{clusterId=\"$cluster\", namespace=\"$namespace\", persistentvolumeclaim=~\"$pvc\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "stackSeries": true,
          "fillOpacity": 40
        }
      },
      {
        "name": "Persistent volumes by phase",
        "description": "Cluster-wide.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (phase) (kube_persistentvolume_status_phase{clusterId=\"$cluster\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "stackSeries": true,
          "fillOpacity": 40
        }
      }
    ],
    "variables": [
      {
