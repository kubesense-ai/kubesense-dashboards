    "panels": [
      {
        "name": "Running",
        "description": "",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum(kube_pod_status_phase{clusterId=\"$cluster\", namespace=\"$namespace\", workload=~\"$workload\", pod=~\"$pod\", phase=\"Running\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {
              "color": {
                "type": "palette",
                "palette": "success"
              }
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
