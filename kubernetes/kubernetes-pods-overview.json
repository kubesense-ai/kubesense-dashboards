            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (namespace, pod) (container_memory_working_set_bytes{clusterId=\"$cluster\", namespace=\"$namespace\", workload=~\"$workload\", pod=~\"$pod\", container!=\"\"})",
