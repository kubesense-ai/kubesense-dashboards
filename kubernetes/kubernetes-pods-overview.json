            "queryMode": "code",
            "promql": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{clusterId=\"$cluster\", namespace=\"$namespace\", workload=~\"$workload\", pod=~\"$pod\", container!=\"\"}[$__rate_interval])) / sum by (namespace, pod) (kube_pod_container_resource_limits{clusterId=\"$cluster\", namespace=\"$namespace\", workload=~\"$workload\", pod=~\"$pod\", resource=\"cpu\"}) * 100",
            "visible": true,
            "filters": {},
