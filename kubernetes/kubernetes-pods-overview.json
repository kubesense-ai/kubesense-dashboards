        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{clusterId=\"$cluster\", namespace=\"$namespace\", workload=~\"$workload\", pod=~\"$pod\", container!=\"\"}[$__rate_interval]))",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "CPU"
        }
      },
