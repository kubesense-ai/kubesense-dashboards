      {
        "name": "CPU utilization",
        "description": "Root cgroup usage against allocatable CPU.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (k8s_node_name) (rate(container_cpu_usage_seconds_total{clusterId=\"$cluster\", k8s_node_name=~\"$node\", id=\"/\"}[$__rate_interval])) / on (k8s_node_name) label_replace(kube_node_status_allocatable{clusterId=\"$cluster\", node=~\"$node\", resource=\"cpu\"}, \"k8s_node_name\", \"$1\", \"node\", \"(.*)\") * 100",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "percentage"
        }
      },
