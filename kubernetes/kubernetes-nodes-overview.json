            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "count(kube_node_status_condition{clusterId=\"$cluster\", node=~\"$node\", condition=~\"MemoryPressure|DiskPressure|PIDPressure\", status=\"true\"} == 1) or vector(0)",
