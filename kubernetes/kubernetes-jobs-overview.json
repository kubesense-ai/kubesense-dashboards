        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum(kube_job_status_active{clusterId=\"$cluster\", namespace=\"$namespace\", job_name=~\"$job\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
