          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "topk(10, time() - max by (namespace, job_name) (kube_job_status_start_time{clusterId=\"$cluster\", namespace=\"$namespace\", job_name=~\"$job\"} unless on (namespace, job_name) kube_job_status_completion_time{clusterId=\"$cluster\", namespace=\"$namespace\", job_name=~\"$job\"}))",
