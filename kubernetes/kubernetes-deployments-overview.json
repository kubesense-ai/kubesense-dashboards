                }
              }
            ],
            "config": {
              "yAxisLabelFormatter": "number"
            }
          },
          {
            "name": "CPU throttling",
            "description": "",
            "panelType": "timeSeries",
            "queries": [
              {
                "selectedMode": "metrics",
                "label": "A",
                "selectedMetric": "",
                "queryMode": "code",
                "promql": "sum by (namespace, workload) (rate(container_cpu_cfs_throttled_periods_total{clusterId=\"$cluster\", namespace=\"$namespace\", workload=~\"$deployment\", container!=\"\"}[$__rate_interval])) / sum by (namespace, workload) (rate(container_cpu_cfs_periods_total{clusterId=\"$cluster\", namespace=\"$namespace\", workload=~\"$deployment\", container!=\"\"}[$__rate_interval])) * 100",
                "visible": true,
                "filters": {},
                "functions": [],
                "labelOptions": {
                  "type": "auto"
                },
                "pagination": {
                  "page": 1,
                  "page_size": 50
                },
                "fieldConfig": {}
