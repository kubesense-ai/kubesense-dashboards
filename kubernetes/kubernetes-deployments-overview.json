                "queryMode": "code",
                "promql": "sum by (namespace, workload) (increase(kube_pod_container_status_restarts_total{clusterId=\"$cluster\", namespace=\"$namespace\", workload=~\"$deployment\"}[$__rate_interval]))",
                "visible": true,
                "filters": {},
                "functions": [],
                "labelOptions": {
                  "type": "auto"
