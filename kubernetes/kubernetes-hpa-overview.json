{
  "meta": {
    "key": "kubernetes-hpa-overview",
    "version": 2,
    "requires": {
      "match": "any",
      "conditions": [
        {
          "env": "kubernetes"
        }
      ]
    },
    "tags": [
      "kubernetes",
      "hpa",
      "autoscaling"
    ]
  },
  "name": "Kubernetes Horizontal Pod Autoscalers Overview",
  "description": "Current, desired and maximum replicas, targets and conditions for HPAs.",
  "preset": {
    "gridLayout": [
      {
        "i": "0",
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 2
      },
      {
        "i": "1",
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 2
      },
      {
        "i": "2",
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 2
      },
      {
        "i": "3",
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 2
      },
      {
        "i": "4",
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 4
      },
      {
        "i": "5",
        "x": 6,
        "y": 2,
        "w": 6,
        "h": 4
      },
      {
        "i": "6",
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 4
      },
      {
        "i": "7",
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 4
      },
      {
        "i": "8",
        "x": 0,
        "y": 10,
        "w": 6,
        "h": 4
      }
    ],
    "panels": [
      {
        "name": "Autoscalers",
        "description": "",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "count(kube_horizontalpodautoscaler_spec_max_replicas{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "At max replicas",
        "description": "Autoscalers that cannot scale out further.",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "count(kube_horizontalpodautoscaler_status_current_replicas{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\"} >= on (namespace, horizontalpodautoscaler) kube_horizontalpodautoscaler_spec_max_replicas{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\"}) or vector(0)",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {
              "color": {
                "type": "palette",
                "palette": "error"
              }
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "Current replicas",
        "description": "",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum(kube_horizontalpodautoscaler_status_current_replicas{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "Desired replicas",
        "description": "",
        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum(kube_horizontalpodautoscaler_status_desired_replicas{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number",
          "valueOptions": {
            "show": "calculate",
            "calculation": "last"
          }
        }
      },
      {
        "name": "Current replicas",
        "description": "",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (namespace, horizontalpodautoscaler) (kube_horizontalpodautoscaler_status_current_replicas{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number"
        }
      },
      {
        "name": "Desired replicas",
        "description": "",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (namespace, horizontalpodautoscaler) (kube_horizontalpodautoscaler_status_desired_replicas{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number"
        }
      },
      {
        "name": "Replicas as a share of max",
        "description": "100% means the autoscaler is pinned at its maximum.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (namespace, horizontalpodautoscaler) (kube_horizontalpodautoscaler_status_current_replicas{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\"}) / sum by (namespace, horizontalpodautoscaler) (kube_horizontalpodautoscaler_spec_max_replicas{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\"}) * 100",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "percentage"
        }
      },
      {
        "name": "Target metric: current vs target",
        "description": "",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (namespace, horizontalpodautoscaler, metric_name) (kube_horizontalpodautoscaler_status_target_metric{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "custom",
              "format": "{{horizontalpodautoscaler}} {{metric_name}} current"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          },
          {
            "selectedMode": "metrics",
            "label": "B",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (namespace, horizontalpodautoscaler, metric_name) (kube_horizontalpodautoscaler_spec_target_metric{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\"})",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "custom",
              "format": "{{horizontalpodautoscaler}} {{metric_name}} target"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {}
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number"
        }
      },
      {
        "name": "Conditions not met",
        "description": "AbleToScale, ScalingActive or ScalingLimited reported false.",
        "panelType": "timeSeries",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "",
            "queryMode": "code",
            "promql": "sum by (namespace, horizontalpodautoscaler, condition) (kube_horizontalpodautoscaler_status_condition{clusterId=\"$cluster\", namespace=\"$namespace\", horizontalpodautoscaler=~\"$hpa\", status=\"false\"}) > 0",
            "visible": true,
            "filters": {},
            "functions": [],
            "labelOptions": {
              "type": "auto"
            },
            "pagination": {
              "page": 1,
              "page_size": 50
            },
            "fieldConfig": {
              "color": {
                "type": "palette",
                "palette": "warning"
              }
            }
          }
        ],
        "config": {
          "yAxisLabelFormatter": "number"
        }
      }
    ],
    "variables": [
      {
        "name": "cluster",
        "description": "",
        "meta": {
          "variableType": "metrics",
          "metric": "kube_node_info",
          "fieldMeta": {
            "field": "clusterId",
            "type": "string",
            "is_attribute": false
          },
          "selectType": "multiple",
          "value": []
        }
      },
      {
        "name": "namespace",
        "description": "",
        "meta": {
          "variableType": "metrics",
          "metric": "kube_pod_info",
          "fieldMeta": {
            "field": "namespace",
            "type": "string",
            "is_attribute": false
          },
          "selectType": "multiple",
          "value": [],
          "filters": {
            "clusterId": [
              "$cluster"
            ]
          }
        }
      },
      {
        "name": "hpa",
        "description": "",
        "meta": {
          "variableType": "metrics",
          "metric": "kube_horizontalpodautoscaler_spec_max_replicas",
          "fieldMeta": {
            "field": "horizontalpodautoscaler",
            "type": "string",
            "is_attribute": false
          },
          "selectType": "multiple",
          "value": [],
          "filters": {
            "clusterId": [
              "$cluster"
            ],
            "namespace": [
              "$namespace"
            ]
          }
        }
      }
    ],
    "subGrids": [],
    "subGridLayout": []
  }
}
