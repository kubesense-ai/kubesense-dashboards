        "panelType": "stat",
        "queries": [
          {
            "selectedMode": "metrics",
            "label": "A",
            "selectedMetric": "kubesense_cloud_resource_metric",
            "queryMode": "builder",
            "promql": "",
            "visible": true,
            "filters": {
              "provider": [
                "aws"
              ],
              "resource_type": [
                "SageMakerTrainingJob",
                "SageMakerProcessingJob",
                "SageMakerTransformJob"
              ],
              "account_id": [
                "$account"
              ],
              "region": [
                "$region"
              ],
              "resource_name": [
                "$resource"
              ],
              "metric_name": [
                "CPUUtilization"
              ]
            },
            "functions": [
              {
                "type": "aggregations",
                "name": "count",
                "arguments": [
                  {
                    "arg_name": "by",
                    "arg_value": [
                      "resource_id"
                    ]
                  }
                ]
              },
              {
                "type": "aggregations",
                "name": "count",
