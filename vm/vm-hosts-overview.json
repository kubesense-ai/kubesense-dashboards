                "promql": "avg(100 * sum by(host_name)(rate(system_cpu_time_seconds_total{kubesense_env_type=\"legacy\", kubesense_cluster=~\"$cluster\", host_name=~\"$host\", state!=\"idle\"}[$__rate_interval])) / sum by(host_name)(rate(system_cpu_time_seconds_total{kubesense_env_type=\"legacy\", kubesense_cluster=~\"$cluster\", host_name=~\"$host\"}[$__rate_interval])))",
