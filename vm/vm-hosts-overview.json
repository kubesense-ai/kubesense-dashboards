          "variableType": "metrics",
          "metric": "system_cpu_time_seconds_total",
          "fieldMeta": {
            "field": "kubesense_cluster",
            "type": "string",
            "is_attribute": false
          },
          "selectType": "multiple",
          "value": [],
          "filters": {
            "kubesense_env_type": [
              "legacy"
            ]
          }
        }
      },
      {
        "name": "host",
        "description": "",
