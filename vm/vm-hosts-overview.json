{
  "meta": {
    "key": "vm-hosts-overview",
    "version": 1,
    "requires": {
      "match": "any",
      "conditions": [
        {
          "env": "legacy"
        }
      ]
    },
    "tags": [
      "vm",
      "hosts"
    ]
