          {
            "name": "VM hosts",
            "description": "",
            "panelType": "stat",
            "queries": [
              {
                "selectedMode": "metrics",
                "label": "A",
                "selectedMetric": "",
                "queryMode": "code",
                "promql": "count(count by(host_name)(system_cpu_time_seconds_total{kubesense_env_type=\"legacy\", kubesense_cluster=~\"$cluster\", host_name=~\"$host\"}))",
                "visible": true,
                "filters": {},
                "functions": [],
                "labelOptions": {
                  "type": "auto"
                },
                "pagination": {
                  "page": 1,
                  "page_size": 50
